From 7c810a0b0afd4b548948c16a2966f4b6f22d4698 Mon Sep 17 00:00:00 2001
From: "jiabin.chen" <jiabin.chen@amlogic.com>
Date: Mon, 9 Feb 2026 11:08:11 +0800
Subject: [PATCH] wifi: fix kscan read beyond the boundaries [1/1]

PD#SWPL-254534

Problem:
kscan read beyond the boundaries

Solution:
Add judgment for reading length

Verify:
s5

Change-Id: I83b9f3b998c2c72d222f8f661925574e2211b14a
Signed-off-by: jiabin.chen <jiabin.chen@amlogic.com>
---
 rtl8852BE/os_dep/linux/ioctl_cfg80211.c | 88 +++++++++++++++++++------
 rtl8852BE/os_dep/osdep_service_linux.c  |  2 +-
 rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.c  |  6 +-
 rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.h  |  2 +-
 5 files changed, 75 insertions(+), 25 deletions(-)

diff --git a/rtl8852BE/os_dep/linux/ioctl_cfg80211.c b/rtl8852BE/os_dep/linux/ioctl_cfg80211.c
index 412b228..6f60609 100755
--- a/rtl8852BE/os_dep/linux/ioctl_cfg80211.c
+++ b/rtl8852BE/os_dep/linux/ioctl_cfg80211.c
@@ -1061,23 +1061,60 @@ check_bss:
 		#else
 		roam_info.bssid = cur_network->network.MacAddress;
 		#endif
-		roam_info.req_ie = pmlmepriv->assoc_req + sizeof(struct rtw_ieee80211_hdr_3addr) + 2;
-		roam_info.req_ie_len = pmlmepriv->assoc_req_len - sizeof(struct rtw_ieee80211_hdr_3addr) - 2;
-		roam_info.resp_ie = pmlmepriv->assoc_rsp + sizeof(struct rtw_ieee80211_hdr_3addr) + 6;
-		roam_info.resp_ie_len = pmlmepriv->assoc_rsp_len - sizeof(struct rtw_ieee80211_hdr_3addr) - 6;
+
+		/*
+		 * Guard against malformed/short assoc_req/assoc_rsp buffers.
+		 * cfg80211 APIs expect pointers to the IE region and the remaining
+		 * length. If the saved buffer is shorter than the expected fixed
+		 * header, avoid underflow and pass NULL/0 instead.
+		 */
+		{
+			u8 *req_ie = NULL, *resp_ie = NULL;
+			u32 req_ie_len = 0, resp_ie_len = 0;
+			u32 hdr_len = sizeof(struct rtw_ieee80211_hdr_3addr);
+
+			if (pmlmepriv->assoc_req && pmlmepriv->assoc_req_len > hdr_len + 2) {
+				req_ie = pmlmepriv->assoc_req + hdr_len + 2;
+				req_ie_len = pmlmepriv->assoc_req_len - hdr_len - 2;
+			}
+
+			if (pmlmepriv->assoc_rsp && pmlmepriv->assoc_rsp_len > hdr_len + 6) {
+				resp_ie = pmlmepriv->assoc_rsp + hdr_len + 6;
+				resp_ie_len = pmlmepriv->assoc_rsp_len - hdr_len - 6;
+			}
+
+			roam_info.req_ie = req_ie;
+			roam_info.req_ie_len = req_ie_len;
+			roam_info.resp_ie = resp_ie;
+			roam_info.resp_ie_len = resp_ie_len;
+		}
 
 		cfg80211_roamed(padapter->pnetdev, &roam_info, GFP_ATOMIC);
 		#else
-		cfg80211_roamed(padapter->pnetdev
-			#if LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 39) || defined(COMPAT_KERNEL_RELEASE)
-			, notify_channel
-			#endif
-			, cur_network->network.MacAddress
-			, pmlmepriv->assoc_req + sizeof(struct rtw_ieee80211_hdr_3addr) + 2
-			, pmlmepriv->assoc_req_len - sizeof(struct rtw_ieee80211_hdr_3addr) - 2
-			, pmlmepriv->assoc_rsp + sizeof(struct rtw_ieee80211_hdr_3addr) + 6
-			, pmlmepriv->assoc_rsp_len - sizeof(struct rtw_ieee80211_hdr_3addr) - 6
-			, GFP_ATOMIC);
+		{
+			u8 *req_ie = NULL, *resp_ie = NULL;
+			u32 req_ie_len = 0, resp_ie_len = 0;
+			u32 hdr_len = sizeof(struct rtw_ieee80211_hdr_3addr);
+
+			if (pmlmepriv->assoc_req && pmlmepriv->assoc_req_len > hdr_len + 2) {
+				req_ie = pmlmepriv->assoc_req + hdr_len + 2;
+				req_ie_len = pmlmepriv->assoc_req_len - hdr_len - 2;
+			}
+
+			if (pmlmepriv->assoc_rsp && pmlmepriv->assoc_rsp_len > hdr_len + 6) {
+				resp_ie = pmlmepriv->assoc_rsp + hdr_len + 6;
+				resp_ie_len = pmlmepriv->assoc_rsp_len - hdr_len - 6;
+			}
+
+			cfg80211_roamed(padapter->pnetdev
+				#if LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 39) || defined(COMPAT_KERNEL_RELEASE)
+				, notify_channel
+				#endif
+				, cur_network->network.MacAddress
+				, req_ie, req_ie_len
+				, resp_ie, resp_ie_len
+				, GFP_ATOMIC);
+		}
 		#endif /*LINUX_VERSION_CODE >= KERNEL_VERSION(4, 12, 0)*/
 
 		RTW_INFO(FUNC_ADPT_FMT" call cfg80211_roamed\n", FUNC_ADPT_ARG(padapter));
@@ -1091,13 +1128,26 @@ check_bss:
 		RTW_INFO("pwdev->sme_state(b)=%d\n", pwdev->sme_state);
 		#endif
 
-		if (check_fwstate(pmlmepriv, WIFI_MONITOR_STATE) != _TRUE)
+		if (check_fwstate(pmlmepriv, WIFI_MONITOR_STATE) != _TRUE) {
+			u8 *req_ie = NULL, *resp_ie = NULL;
+			u32 req_ie_len = 0, resp_ie_len = 0;
+			u32 hdr_len = sizeof(struct rtw_ieee80211_hdr_3addr);
+
+			if (pmlmepriv->assoc_req && pmlmepriv->assoc_req_len > hdr_len + 2) {
+				req_ie = pmlmepriv->assoc_req + hdr_len + 2;
+				req_ie_len = pmlmepriv->assoc_req_len - hdr_len - 2;
+			}
+
+			if (pmlmepriv->assoc_rsp && pmlmepriv->assoc_rsp_len > hdr_len + 6) {
+				resp_ie = pmlmepriv->assoc_rsp + hdr_len + 6;
+				resp_ie_len = pmlmepriv->assoc_rsp_len - hdr_len - 6;
+			}
+
 			rtw_cfg80211_connect_result(pwdev, cur_network->network.MacAddress
-				, pmlmepriv->assoc_req + sizeof(struct rtw_ieee80211_hdr_3addr) + 2
-				, pmlmepriv->assoc_req_len - sizeof(struct rtw_ieee80211_hdr_3addr) - 2
-				, pmlmepriv->assoc_rsp + sizeof(struct rtw_ieee80211_hdr_3addr) + 6
-				, pmlmepriv->assoc_rsp_len - sizeof(struct rtw_ieee80211_hdr_3addr) - 6
+				, req_ie, req_ie_len
+				, resp_ie, resp_ie_len
 				, WLAN_STATUS_SUCCESS, GFP_ATOMIC);
+		}
 		#if LINUX_VERSION_CODE < KERNEL_VERSION(3, 11, 0) || defined(COMPAT_KERNEL_RELEASE)
 		RTW_INFO("pwdev->sme_state(a)=%d\n", pwdev->sme_state);
 		#endif
diff --git a/rtl8852BE/os_dep/osdep_service_linux.c b/rtl8852BE/os_dep/osdep_service_linux.c
index 3591f52..e3df5ae 100644
--- a/rtl8852BE/os_dep/osdep_service_linux.c
+++ b/rtl8852BE/os_dep/osdep_service_linux.c
@@ -213,7 +213,7 @@ void rtw_sleep_schedulable(int ms)
 void rtw_msleep_os(int ms)
 {
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 36))
-	if (ms < 20) {
+	if (ms < 9) {
 		unsigned long us = ms * 1000UL;
 		usleep_range(us, us + 1000UL);
 	} else
diff --git a/rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.c b/rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.c
index f51290b..24559a9 100755
--- a/rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.c
+++ b/rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.c
@@ -1186,7 +1186,7 @@ static u32 fwdl_phase0(struct mac_ax_adapter *adapter)
 	while (--cnt) {
 		if (MAC_REG_R8(R_AX_WCPU_FW_CTRL) & B_AX_H2C_PATH_RDY)
 			break;
-		PLTFM_DELAY_US(1);
+		PLTFM_DELAY_MS(10);
 	}
 
 	if (!cnt) {
@@ -1222,7 +1222,7 @@ static u32 fwdl_phase1(struct mac_ax_adapter *adapter,
 	while (--cnt) {
 		if (MAC_REG_R8(R_AX_WCPU_FW_CTRL) & B_AX_FWDL_PATH_RDY)
 			break;
-		PLTFM_DELAY_US(1);
+		PLTFM_DELAY_MS(10);
 	}
 
 	if (!cnt) {
@@ -1470,7 +1470,7 @@ static u32 check_fw_rdy(struct mac_ax_adapter *adapter)
 			PLTFM_MSG_ERR("[ERR]%s: 0x1E0[7:5] last value = %d\n", __func__, val8);
 			return MACFWCUT;
 		}
-		PLTFM_DELAY_US(1);
+		PLTFM_DELAY_MS(10);
 	}
 
 	if (!cnt) {
diff --git a/rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.h b/rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.h
index ea028de..8856b2b 100755
--- a/rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.h
+++ b/rtl8852BE/phl/hal_g6/mac/mac_ax/fwdl.h
@@ -166,7 +166,7 @@ FWDL_SUPPORT_8852BT)
 #define RTL8851B_ROM_ADDR 0x18900000
 #define RTL8852D_ROM_ADDR 0x20000000
 #define RTL8852BT_ROM_ADDR 0x18900000
-#define FWDL_WAIT_CNT 400000
+#define FWDL_WAIT_CNT 40
 #define FWDL_SECTION_MAX_NUM 6
 #define FWDL_SECURITY_SECTION_CONSTANT (64 + (FWDL_SECTION_MAX_NUM * 32 * 2))
 #define FWDL_SECURITY_SECTION_TYPE 9
-- 
2.42.0

